            "in": "header",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateApplicationDto" }
            }
          }
        },
        "responses": { "201": { "description": "" } },
        "tags": ["applications"]
      },
      "get": {
        "operationId": "ApplicationsController_findAll",
        "parameters": [
          {
            "name": "status",
