          "customerDocument": { "type": "string" },
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string" },
          "channel": { "type": "string" },
          "product": { "type": "string" },
          "requestedAmount": { "type": "number" },
          "requestedTermMonths": { "type": "number" }
