                "IN_PROGRESS",
                "PENDING_VALIDATION",
                "FINALIZED",
                "ABANDONED"
              ]
            }
          },
          {
            "name": "channel",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "enum": ["SELF_SERVICE", "ASSISTED"] }
          },
          {
            "name": "customerDocument",
            "required": false,
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "createdFrom",
            "required": false,
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "createdTo",
            "required": false,
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "" } },
        "tags": ["applications"]
      }
